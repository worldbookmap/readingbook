#!/bin/sh

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)

if [ "$branch" != "main" ]; then
  exit 0
fi

printf '%s\n' 'Auto-pushing main to origin...'
if ! git push origin main; then
  printf '%s\n' 'Auto-push failed. The commit is preserved; resolve the remote state and run: git push origin main' >&2
  exit 1
fi
